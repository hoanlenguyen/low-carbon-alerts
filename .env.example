# nuxt-auth-utils session cookie sealing secret (32+ chars)
NUXT_SESSION_PASSWORD=

# Turso database (libSQL)
NUXT_TURSO_URL=libsql://your-db-name.turso.io
NUXT_TURSO_AUTH_TOKEN=

# Google OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Facebook OAuth
NUXT_OAUTH_FACEBOOK_CLIENT_ID=
NUXT_OAUTH_FACEBOOK_CLIENT_SECRET=

# Firebase Cloud Messaging (server-side)
NUXT_FCM_SERVICE_ACCOUNT=
NUXT_FCM_PROJECT_ID=

# Firebase (client-side)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# One-off token to seed the first admin (delete after seeding)
NUXT_SETUP_TOKEN=
